# pnpm 配置：把 workspace 依赖 hoist 到顶层 node_modules/@vynth/，
# 让 `bun test packages` 能解析 `import ... from '@vynth/xxx'`。
#
# 不加此配置时，pnpm 默认严格隔离：workspace 依赖仅在子包本地 node_modules 可见，
# 而 bun test 从仓库根执行，需在顶层解析 @vynth/*。shamefully-hoist 是 pnpm 官方推荐的
# 「兼容 bun / yarn / npm 链接查找行为」开关。
shamefully-hoist=true

# 安装时不自动跑构建脚本（biome 等无需 preinstall 编译）
ignore-build-scripts=true